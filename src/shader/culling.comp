/**
 * @file culling.comp
 * @brief GPU 视锥剔除 Compute Shader
 *
 * Phase 9 核心 shader。每个线程处理一个图元，
 * 进行 2D AABB-视图矩形相交测试，为可见图元生成 indirect draw 命令。
 *
 * 与 CPU 侧四叉树保持一致的剔除语义：
 *   世界空间包围盒与视图矩形做 AABB 相交测试。
 *
 * SSBO 绑定：
 *   binding = 0: EntityData[]   图元元数据数组
 *   binding = 1: uint[]         可见性结果数组（输出）
 *   binding = 2: DrawCommand[]  indirect draw 命令数组（输出）
 *   binding = 3: uint           原子计数器（输出命令数量）
 */
#version 460 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// ============================================================================
// SSBO 定义
// ============================================================================

struct EntityData
{
    vec4  bboxMin;       // xyz = min, w = padding
    vec4  bboxMax;       // xyz = max, w = padding
    vec4  worldPos;      // xyz = position, w = padding
    uint  vertexOffset;  // 顶点缓冲偏移
    uint  vertexCount;   // 顶点数量
    uint  materialIndex; // 材质索引
    uint  flags;         // 标志位
};

layout(std430, binding = 0) readonly buffer EntityBuffer
{
    EntityData entities[];
};

layout(std430, binding = 1) writeonly buffer VisibilityBuffer
{
    uint visibility[];
};

struct DrawCommand
{
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint baseInstance;
};

layout(std430, binding = 2) writeonly buffer IndirectBuffer
{
    DrawCommand commands[];
};

layout(std430, binding = 3) buffer CountBuffer
{
    uint commandCount;
};

// ============================================================================
// Uniform
// ============================================================================

// 2D 视图矩形（世界空间），与 CPU 四叉树的 frustum 矩形语义一致
layout(location = 0) uniform vec4 uViewBounds; // x=minX, y=minY, z=maxX, w=maxY
layout(location = 1) uniform int  uEntityCount;

// ============================================================================
// 辅助函数
// ============================================================================

/**
 * @brief 2D AABB-视图矩形相交测试
 *
 * 与 CPU 侧四叉树 queryVisible 保持一致的语义：
 * 检测图元包围盒是否与视图矩形相交。
 * 若完全不相交，则判定为不可见。
 */
bool isVisible(const vec2 bboxMin, const vec2 bboxMax)
{
    float viewMinX = uViewBounds.x;
    float viewMinY = uViewBounds.y;
    float viewMaxX = uViewBounds.z;
    float viewMaxY = uViewBounds.w;

    // AABB 相交测试：若在某个轴上完全分离，则不相交
    if (bboxMax.x < viewMinX || bboxMin.x > viewMaxX)
        return false;
    if (bboxMax.y < viewMinY || bboxMin.y > viewMaxY)
        return false;

    return true;
}

// ============================================================================
// 主入口
// ============================================================================

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= uint(uEntityCount))
        return;

    EntityData e = entities[idx];

    // vertexCount == 0 表示已删除/无效图元
    if (e.vertexCount == 0u)
    {
        visibility[idx] = 0u;
        return;
    }

    bool visible = isVisible(e.bboxMin.xy, e.bboxMax.xy);

    if (visible)
    {
        visibility[idx] = 1u;

        // 原子递增获取写入位置
        uint slot = atomicAdd(commandCount, 1u);

        DrawCommand cmd;
        cmd.vertexCount   = e.vertexCount;
        cmd.instanceCount = 1u;
        cmd.firstVertex   = e.vertexOffset;
        cmd.baseInstance  = 0u;
        commands[slot] = cmd;
    }
    else
    {
        visibility[idx] = 0u;
    }
}
